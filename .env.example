# ── App ────────────────────────────────────────────────
# Local: postgres://postgres:postgres@127.0.0.1:5432/elephant_archive
# Production: your Neon connection string (use the pooled one, with ?sslmode=require)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/elephant_archive
# Long random string: `openssl rand -hex 32`. Never commit the real one.
PAYLOAD_SECRET=change-me

# ── Fact-check pipeline (pnpm ingest) ─────────────────
PIPELINE_LLM=subscription        # subscription (your Claude plan via Claude Code) | off | api
PIPELINE_CLI_MODEL=sonnet        # model alias for claude -p
PIPELINE_MAX_BATCHES=10          # batches per run
LOCATION_EMBARGO_DAYS=180        # living-elephant events newer than this are blocked
ARCHIVE_ON_CHECK=0               # 1 = ask the Wayback Machine to save each source
# Do NOT set ANTHROPIC_API_KEY unless PIPELINE_LLM=api — it would switch billing to the API.
