# Copy to .env and fill in. Never commit .env.
# Every variable the code reads is listed here. Defaults are in the comments.

# ── App ────────────────────────────────────────────────
# Postgres connection string. Local: postgres://USER:PASS@127.0.0.1:5432/elephant_archive
# Production: Neon pooled connection string with ?sslmode=require
DATABASE_URL=
# Long random string for Payload auth/encryption (`openssl rand -hex 32`)
PAYLOAD_SECRET=

# ── Fact-check pipeline (pnpm ingest, local only) ──────
# Who runs model calls: subscription (Claude Code on your plan) | api | off. Default: subscription
PIPELINE_LLM=
# Model alias passed to `claude -p` when PIPELINE_LLM=subscription. Default: sonnet
PIPELINE_CLI_MODEL=
# Path to the Claude Code binary if `claude` is not on PATH. Default: claude
CLAUDE_BIN=
# Model ID used only when PIPELINE_LLM=api. Default: claude-sonnet-5-5
PIPELINE_LLM_MODEL=
# Max intake batches per `pnpm ingest` run. Default: 10
PIPELINE_MAX_BATCHES=
# Living-elephant events newer than this many days are blocked. Default: 180
LOCATION_EMBARGO_DAYS=
# 1 = ask the Wayback Machine to save each source during checks. Default: off
ARCHIVE_ON_CHECK=

# Read by the Anthropic SDK only when PIPELINE_LLM=api. Leave unset otherwise:
# if set, Claude Code bills the API instead of your plan.
# ANTHROPIC_API_KEY=

# ── Tests ──────────────────────────────────────────────
# Set automatically by GitHub Actions; makes Playwright stricter (retries, no .only). Don't set locally.
# CI=
